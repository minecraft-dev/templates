name: ${PLUGIN_NAME}
#if (${DESCRIPTION})
description: ${DESCRIPTION}
#end
#if (${LOG_PREFIX})
prefix: ${LOG_PREFIX}
#end
version: '$version'

main: ${MAIN_CLASS}
#if (${API_VERSION})
api-version: '${API_VERSION}'
#end
#if (${LOAD_AT})
load: ${LOAD_AT}
#end
#if ($AUTHORS || $WEBSITE)

#if ($AUTHORS)
authors: ${AUTHORS.toString(", ", "[", "]")}
#end
#if (${WEBSITE})
website: ${WEBSITE}
#end
#end
