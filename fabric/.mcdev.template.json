{
  "version": 4,
  "group": "mod",
  "properties": [
    {
      "name": "LANGUAGE",
      "type": "string",
      "options": [
        "Java",
        "Kotlin"
      ],
      "default": 0
    },
    {
      "name": "MC_VERSION",
      "type": "fabric_game_version",
      "remember": false
    },
    {
      "name": "USE_GRADLE_KOTLIN_DSL",
      "type": "boolean",
      "remember": "fabric.USE_GRADLE_KOTLIN_DSL",
      "default": false
    },
    {
      "name": "USE_MOJANG_MAPPINGS",
      "type": "boolean",
      "remember": "fabric.USE_MOJANG_MAPPINGS",
      "default": true,
      "visible": {
        "dependsOn": ["MC_VERSION"],
        "condition": "$MC_VERSION.compareTo($mcver.MC26_1) < 0"
      }
    },
    {
      "name": "USE_DATAGEN",
      "type": "boolean",
      "default": false,
      "visible": {
        "dependsOn": ["MC_VERSION"],
        "condition": "$MC_VERSION.compareTo($mcver.MC1_17) >= 0"
      }
    },
    {
      "name": "SPLIT_SOURCES",
      "type": "boolean",
      "default": true,
      "visible": {
        "dependsOn": ["MC_VERSION"],
        "condition": "$MC_VERSION.compareTo($mcver.MC1_19) >= 0"
      }
    },
    {
      "name": "MOD_ID",
      "type": "string",
      "validator": "[a-z][a-z0-9-_]{1,63}",
      "derives": {
        "parents": ["PROJECT_NAME"],
        "method": "replace",
        "parameters": {
          "regex": "[^a-z0-9-_]+",
          "replacement": "_",
          "maxLength": 64,
          "lowercase": true
        }
      }
    },
    {
      "name": "MOD_NAME",
      "type": "string",
      "inheritFrom": "PROJECT_NAME"
    },
    {
      "name": "MOD_ID_PACKAGE_SEGMENT",
      "type": "string",
      "visible": false,
      "derives": {
        "parents": ["MOD_ID"],
        "method": "replace",
        "parameters": {
          "regex": "-",
          "replacement": "_"
        }
      }
    },
    {
      "name": "PACKAGE_NAME",
      "type": "string",
      "validator": "[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*",
      "derives": {
        "parents": ["MOD_ID_PACKAGE_SEGMENT"],
        "method": "replace",
        "parameters": {
          "regex": "^",
          "replacement": "com.example."
        }
      }
    },
    {
      "name": "LICENSE",
      "type": "license"
    },
    {
      "label": "creator.ui.optional_settings.label",
      "collapsible": true,
      "groupProperties": [
        {
          "name": "AUTHORS",
          "type": "inline_string_list",
          "default": ""
        }
      ]
    },
    {
      "name": "JAVA_VERSION",
      "type": "integer",
      "order": 20,
      "default": 21,
      "visible": false,
      "derives": {
        "parents": ["MC_VERSION"],
        "method": "recommendJavaVersionForMcVersion",
        "default": 21
      }
    },
    {
      "name": "JDK",
      "type": "jdk",
      "order": 20,
      "default": "JAVA_VERSION"
    }
  ],
  "finalizers": [
    {
      "type": "run_npm_package",
      "package": "@fabricmc/cli",
      "command": "fabric",
      "args": [
        "init",
        "--defaultOptions",
        "--allow-non-empty-dir",
        "--name=$MOD_NAME",
        "--modid=$MOD_ID",
        "--packageName=$PACKAGE_NAME",
        "--version=$MC_VERSION",
        "--option=kotlin=$LANGUAGE.equals('Kotlin')",
        "--option=gradleKotlin=$USE_GRADLE_KOTLIN_DSL",
        "--option=mojangMappings=$USE_MOJANG_MAPPINGS",
        "--option=datagen=#if ($USE_DATAGEN && $MC_VERSION.compareTo($mcver.MC1_17) >= 0)true#{else}false#end",
        "--option=splitSources=#if ($SPLIT_SOURCES && $MC_VERSION.compareTo($mcver.MC1_19) >= 0)true#{else}false#end",
        "."
      ]
    },
    {
      "type": "generate_files",
      "files": [
        {
          "template": "../licenses/${LICENSE.id}.txt.ft",
          "destination": "LICENSE"
        }
      ]
    },
    {
      "type": "replace_in_file",
      "file": "src/main/resources/fabric.mod.json",
      "find": "\"license\"\\s*:\\s*\"[^\"]*\"",
      "regex": true,
      "replace": "\"license\": \"${LICENSE.id}\""
    },
    {
      "type": "import_gradle_project"
    },
    {
      "type": "add_gradle_run",
      "tasks": [
        "build"
      ],
      "name": "Build"
    },
    {
      "type": "git_add_all",
      "condition": "$USE_GIT"
    }
  ]
}
